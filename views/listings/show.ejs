<%- include("../partials/header") %>

<div class="container mt-4 mb-5">

  <h2 class="fw-bold mb-3"><%= listing.title %></h2>
  <p class="text-muted">
    <i class="bi bi-geo-alt-fill"></i>
    <%= listing.location %>, <%= listing.country %>
  </p>

  <img src="<%= listing.image.url %>" class="listing-image mb-4" />

  <div class="row">

    <!-- LEFT -->
    <div class="col-lg-8">

      <h4>About this place</h4>
      <p class="mt-3 fs-5"><%= listing.description %></p>

      <div class="mt-4 p-4 bg-white rounded shadow-sm">
        <h4 class="fw-bold mb-3">Book This Place</h4>

        <form action="/book/<%= listing._id %>" method="POST">
          <label class="form-label">Check-in:</label>
          <input type="date" name="checkIn" class="form-control" required>

          <label class="form-label mt-3">Check-out:</label>
          <input type="date" name="checkOut" class="form-control" required>

          <button class="btn btn-primary mt-4 w-100">Book Now</button>
        </form>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="col-lg-4">
      <div class="p-4 bg-white rounded shadow-sm">

        <h3 class="fw-bold">$<%= listing.price %></h3>
        <p class="text-muted">per night</p>

        <% if (session.isAdmin) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary w-100 mb-2">
            <i class="bi bi-pencil-square"></i> Edit
          </a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-danger w-100">
              <i class="bi bi-trash"></i> Delete Listing
            </button>
          </form>
        <% } %>

        <a href="/listings" class="btn btn-secondary w-100 mt-3">
          <i class="bi bi-arrow-left"></i> Back
        </a>

      </div>
    </div>

  </div>
</div>

<%- include("../partials/footer") %>
