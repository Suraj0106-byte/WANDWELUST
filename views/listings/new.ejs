<%- include("../partials/header") %>

<div class="container mt-5 mb-5">
  <h2 class="text-center mb-4 fw-bold">Create a New Listing</h2>

  <div class="form-box">

    <form method="POST" action="/listings">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="listing[title]" type="text" class="form-control" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" rows="4" required></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Image URL</label>
        <input name="listing[image.url]" type="text" class="form-control" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Price (per night)</label>
        <input name="listing[price]" type="number" class="form-control" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Country</label>
        <input name="listing[country]" type="text" class="form-control" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input name="listing[location]" type="text" class="form-control" required />
      </div>

      <div class="d-flex justify-content-between mt-4">
        <a href="/listings" class="btn btn-secondary">Cancel</a>
        <button class="btn btn-primary">Create Listing</button>
      </div>

    </form>

  </div>
</div>

<%- include("../partials/footer") %>
