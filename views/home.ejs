<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WanderLust • Find Your Next Stay</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="stylesheet" href="/style.css" />
</head>

<body class="bg-light">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold fs-3" href="/">WanderLust</a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a href="/listings" class="nav-link">Explore</a>
          </li>
          <li class="nav-item">
            <a href="/listings/new" class="btn btn-primary">+ Create Listing</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="p-5 text-center bg-white">
    <h1 class="fw-bold display-4">Find Unique Places to Stay</h1>
    <p class="text-muted fs-5">
      Book accommodations from hosts all over the world.
    </p>
    <a href="/listings" class="btn btn-lg btn-danger mt-3">Start Exploring</a>
  </section>

  <!-- FEATURED IMAGES -->
  <section class="container my-5">
    <div class="row g-4">
      <div class="col-md-4">
        <img src="https://source.unsplash.com/600x400/?travel,resort" class="img-fluid rounded-4 shadow-sm" />
      </div>
      <div class="col-md-4">
        <img src="https://source.unsplash.com/600x400/?mountains,cabin" class="img-fluid rounded-4 shadow-sm" />
      </div>
      <div class="col-md-4">
        <img src="https://source.unsplash.com/600x400/?beach,hotel" class="img-fluid rounded-4 shadow-sm" />
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-white text-center py-3 shadow-sm mt-5">
    <p class="text-muted m-0">© 2025 WanderLust — Inspired by Airbnb</p>
  </footer>

</body>
</html>
