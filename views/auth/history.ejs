<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Booking History - WanderLust</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>

<%- include("../partials/navbar") %>

<div class="container mt-5">

  <h2 class="fw-bold mb-4">My Booking History</h2>

  <% if (bookings.length === 0) { %>
    <p class="text-muted">You have no bookings yet.</p>
  <% } %>

  <div class="row">
    <% bookings.forEach(b => { %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm p-3">

          <h5><%= b.listing.title %></h5>
          <p class="text-muted"><%= b.listing.location %>, <%= b.listing.country %></p>
          
          <p>Check-in: <b><%= b.checkIn.toDateString() %></b></p>
          <p>Check-out: <b><%= b.checkOut.toDateString() %></b></p>
          <p>Total Price: <b>$<%= b.totalPrice %></b></p>

          <a href="/receipt/<%= b._id %>" class="btn btn-outline-primary btn-sm mt-2">Download Receipt</a>
        </div>
      </div>
    <% }) %>
  </div>

</div>

</body>
</html>
