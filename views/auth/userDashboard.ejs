<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Dashboard - WanderLust</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>

<%- include("../partials/navbar") %>

<div class="container mt-5">
  <h2 class="fw-bold mb-4">Welcome to your Dashboard 👋</h2>

  <div class="row">
    <div class="col-md-4">
      <a href="/profile" class="text-decoration-none">
        <div class="card shadow-sm p-4 text-center">
          <h4>My Profile</h4>
        </div>
      </a>
    </div>

    <div class="col-md-4">
      <a href="/history" class="text-decoration-none">
        <div class="card shadow-sm p-4 text-center">
          <h4>Booking History</h4>
        </div>
      </a>
    </div>

    <div class="col-md-4">
      <a href="/listings" class="text-decoration-none">
        <div class="card shadow-sm p-4 text-center">
          <h4>Browse Listings</h4>
        </div>
      </a>
    </div>
  </div>
</div>

</body>
</html>
