<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Login - WanderLust</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>

<%- include("../partials/navbar") %>

<div class="container d-flex justify-content-center mt-5">
  <div class="card shadow p-4" style="width: 420px;">
    <h3 class="text-center mb-3 fw-bold">Login with OTP</h3>

    <form action="/send-otp" method="POST">

      <label class="form-label">Phone Number</label>
      <input type="text" name="phone" class="form-control mb-3" placeholder="+91XXXXXXXXXX" required>

      <button class="btn btn-dark w-100">Send OTP</button>
    </form>
  </div>
</div>

</body>
</html>
